# Copy this file to .env and fill in your own values.
#
# Create a scoped personal access token at https://airtable.com/create/tokens
# with data.records:read and data.records:write on the base below.
#
# Note: Vite inlines every VITE_-prefixed variable into the client bundle at
# build time, so this token is readable by anyone who opens the deployed site.
# See the Tradeoffs section of the README before pointing this at a base that
# holds anything you care about.

VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
VITE_AIRTABLE_TABLE_ID=tblXXXXXXXXXXXXXX
VITE_AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
